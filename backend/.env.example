# App identity
PROJECT_NAME=GraphMind
VERSION=0.1.0
# CI/Docker can fill this in with `git rev-parse HEAD`.
GIT_SHA=
ENVIRONMENT=development
DEBUG=false

# API server
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Auth
# Generate a real value before deploying:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Local development may use this placeholder only with AUTH_REQUIRED=false.
SECRET_KEY=dev-only-change-me-before-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=graphmind_refresh
# Use true behind HTTPS in staging and production.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
REDIS_URL=redis://localhost:6379/0
# Development-only fallback when Redis is not running; keep false in production.
WEBSOCKET_TICKET_MEMORY_FALLBACK=true
# Keep false only for the account-free local workspace. Staging and production
# must use AUTH_REQUIRED=true with a private SECRET_KEY of at least 32 chars.
AUTH_REQUIRED=false
# Create an OAuth App under GitHub Developer settings.
# Homepage: http://localhost:5173
# Callback: http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# Database
# Local dev can use SQLite. Production should use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://graphmind:graphmind@postgres:5432/graphmind
DATABASE_URL=sqlite:///./graphmind.db

# Celery
# Local dev can leave Celery off. Docker/production should use Redis.
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_ENABLED=false
# Reindex beat is off by default so local dev does not unexpectedly reprocess files.
CELERY_REINDEX_ENABLED=false
CELERY_REINDEX_INTERVAL_SECONDS=86400
CELERY_TASK_DEFAULT_QUEUE=documents
CELERY_JOB_CLEANUP_ENABLED=false
CELERY_JOB_CLEANUP_INTERVAL_SECONDS=86400
JOB_HISTORY_RETENTION_DAYS=30

# Entity extraction
# Extra spaCy models are optional. Missing models are skipped at startup.
SPACY_MODEL=en_core_web_sm
SPACY_EXTRA_MODELS=["zh_core_web_sm"]

# Rate limiting
# Uses REDIS_URL by default so limits are shared across API instances.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_DEFAULT=200/day;50/hour
RATE_LIMIT_UPLOAD=10/minute;100/hour
RATE_LIMIT_CHAT=30/minute;500/day
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_GRAPH_READ=120/minute
RATE_LIMIT_VIDEO=5/hour
RATE_LIMIT_SCRAPE=10/hour
RATE_LIMIT_LITERATURE=10/hour;50/day
TRUSTED_PROXY_IPS=["127.0.0.1","::1"]

# Metrics
# Exposes /metrics for Prometheus when prometheus_client is installed.
METRICS_ENABLED=true

# Sentry
# Local dev stays off. Set SENTRY_ENABLED=true and SENTRY_DSN in production.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Medical document insights. The extractive provider is local and reproducible.
# A remote provider should only be enabled after its privacy and cost settings
# are reviewed for the deployment environment.
MEDICAL_AI_ENABLED=true
MEDICAL_AI_PROVIDER=extractive
MEDICAL_AI_MODEL=extractive-v1
MEDICAL_AI_TIMEOUT_SECONDS=30
MEDICAL_AI_MAX_INPUT_TOKENS=12000
MEDICAL_AI_MAX_OUTPUT_TOKENS=5000
MEDICAL_AI_PROVIDER_RETRY_COUNT=2
MEDICAL_AI_REDACT_PII=true
MEDICAL_AI_PROMPT_VERSION=medical-insights-v2
MEDICAL_AI_SCHEMA_VERSION=medical-insights-v2
# To use the external provider, set MEDICAL_AI_PROVIDER=openai, choose a model,
# and provide the key below. Selected redacted excerpts are sent to OpenAI.
MEDICAL_AI_OPENAI_API_KEY=

# PubMed literature search. The preview endpoint shows the exact query before
# the confirmed query terms are sent to NCBI. The uploaded document is not sent.
LITERATURE_SEARCH_ENABLED=true
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_API_KEY=
PUBMED_TOOL=graphmind
# NCBI recommends identifying automated clients with a contact email.
PUBMED_EMAIL=
PUBMED_TIMEOUT_SECONDS=15
PUBMED_MAX_RESULTS=50
PUBMED_CACHE_TTL_SECONDS=86400
PUBMED_MAX_RESPONSE_BYTES=5242880
PUBMED_RETRY_COUNT=2
# Shared Redis token bucket: 3 requests/second without a key, 10 with a key.
# Outside development/test, Redis coordination is required and fails closed.
PUBMED_RATE_LIMIT_ENABLED=true
PUBMED_RATE_LIMIT_NO_KEY_REQUESTS_PER_SECOND=3
PUBMED_RATE_LIMIT_WITH_KEY_REQUESTS_PER_SECOND=10
PUBMED_RATE_LIMIT_REDIS_REQUIRED=true
# Read-only, versioned local disease ontology. The application ships with a
# valid package at this path; production must not replace it with user input.
# MEDICAL_ONTOLOGY_DIR=/absolute/path/to/backend/app/services/medical/terminology/resources

# Frontend origins allowed by FastAPI CORS middleware.
# Keep this as JSON because pydantic-settings parses List[str] from env.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Upload and storage
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local
# Optional S3/MinIO backend. Keep STORAGE_BACKEND=local unless MinIO/S3 is running.
S3_BUCKET=graphmind
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION_NAME=us-east-1
S3_PREFIX=uploads
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".md",".pdf",".txt",".docx",".py",".js",".ts",".json",".csv",".html",".htm"]

# Virus scanning
# Local dev can leave this off unless clamd is running.
# In production set VIRUS_SCAN_ENABLED=true and VIRUS_SCAN_FAIL_OPEN=false.
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_FAIL_OPEN=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Optional LLM layer for AI chat.
# Without this, chat still returns local retrieval-based answers.
OPENAI_API_KEY=
OPENAI_MODEL=
